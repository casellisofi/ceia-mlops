# PostgreSQL
PG_USER=airflow
PG_PASSWORD=airflow
PG_DATABASE=airflow
PG_PORT=5432

# MinIO (S3-compatible)
MINIO_ACCESS_KEY=minio
MINIO_SECRET_ACCESS_KEY=minio123
MINIO_PORT=9000
MINIO_PORT_UI=9001
MLFLOW_BUCKET_NAME=mlflow
DATA_REPO_BUCKET_NAME=data
LAKE_BUCKET_NAME=datalake

# MLflow
MLFLOW_PORT=5000

# Airflow
AIRFLOW_PORT=8080
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# FastAPI
FASTAPI_PORT=8800
# Modelo a servir: stroke-predictor (centralizado) o stroke-predictor-federated
MODEL_NAME=stroke-predictor
# Umbral de respaldo (la API usa el que registro el entrenamiento en MLflow)
STROKE_THRESHOLD=0.17847

# gRPC
GRPC_PORT=50051

# --- Seguridad ---
# Claves de acceso a la API, formato nombre:rol:clave separadas por coma (roles: predictor | admin).
# Si queda vacio la API rechaza todo acceso protegido. Generar cada clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Peticiones por minuto permitidas por cliente (compartido entre REST, GraphQL y gRPC)
RATE_LIMIT_PER_MIN=60
# Usuario de MinIO de minimo privilegio para la API (no es el usuario raiz). Elegir una clave propia.
API_S3_USER=api_user
API_S3_PASSWORD=
